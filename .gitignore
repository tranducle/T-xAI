# Datasets are never committed. They are large, they belong to their publishers,
# and a local copy carries the reader's own directory layout with it.
data/
*.npz
*.dat
*.jsonl
*.csv

# Run logs. results/*.json is committed on purpose -- it is the paper's evidence;
# the logs beside it are not.
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
